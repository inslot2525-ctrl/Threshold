# =============================================================================
# Ring Partner API — authentication (choose ONE)
# =============================================================================
# Option 1: Playground access token (valid 30 min)
#   https://developer.amazon.com/ring/console/playground
# RING_ACCESS_TOKEN=

# Option 2: Refresh token from account linking (auto-renews)
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=

# HMAC signing key issued with your partner credentials.
# Used to verify X-Signature on incoming webhooks. The simulator signs with it too.
# RING_HMAC_KEY=

# =============================================================================
# AWS (optional) — Bedrock describes snapshots, SNS texts the caregiver
# =============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Snapshot descriptions: auto (Bedrock, then Rekognition labels) | bedrock | rekognition
# DESCRIBE_PROVIDER=auto
# SNS_TOPIC_ARN=

# =============================================================================
# App
# =============================================================================
# Public base URL used in share links sent to the caregiver (e.g. your ngrok URL)
# PUBLIC_BASE_URL=http://localhost:3000

# Set to false to hide the demo simulator
# SIMULATOR_ENABLED=true
